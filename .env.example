# Web panel
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Public BlockCtrl panel origin used by deployed websites for live data, login/register and forms.
# In production set this to the public panel URL, e.g. https://your-panel.vercel.app
BLOCKCTRL_PUBLIC_URL=

# PostgreSQL / Neon (one connection URL is enough)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
# POSTGRES_URL=
# NEON_DATABASE_URL=
# For Vercel/serverless production, prefer Neon's pooled connection string (hostname usually contains -pooler).
# Per-function node-postgres pool controls. Keep the total across autoscaled instances within DB limits.
PG_POOL_MAX=10
PG_POOL_IDLE_TIMEOUT_MS=10000
PG_POOL_CONNECTION_TIMEOUT_MS=10000
PG_POOL_MAX_LIFETIME_SECONDS=300

# Supabase Auth
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
# Legacy/alternative names supported by the current code:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_URL=
# SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_ANON_KEY=

# BlockCtrl website publishing (server-side only)
# Create a Vercel access token with project/deployment permissions.
VERCEL_TOKEN=
# On Vercel, VERCEL_ORG_ID can be used automatically; set TEAM_ID explicitly outside Vercel.
VERCEL_TEAM_ID=
# Optional alternative to VERCEL_TEAM_ID:
# VERCEL_TEAM_SLUG=
# Free website project names become: <website-name>-blockctrl.vercel.app
BLOCKCTRL_WEBSITE_PROJECT_SUFFIX=blockctrl
# Website builder image/video uploads (Vercel Blob)
# Vercel Blob store connection normally provides this automatically in production.
BLOB_READ_WRITE_TOKEN=

# Website server-registration bridge (server/plugin -> BlockCtrl website account provisioning)
# Use a long random secret; never expose it to browser code.
BLOCKCTRL_SITE_SERVER_BRIDGE_KEY=

# Integrations
# Optional Discord bot worker. Webhooks work without this; bot-specific commands/events require a deployed worker.
DISCORD_BOT_WORKER_URL=
# Optional direct WebRTC/live-stream gateway. External YouTube/Twitch/Kick links work without it.
LIVE_STREAM_GATEWAY_URL=

# Streaming OAuth applications. Configure provider callback URLs as:
#   <NEXT_PUBLIC_APP_URL>/api/integrations/oauth/callback?platform=<youtube|twitch|kick>
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=

# Integration secrets are encrypted at rest by lib/integrations. Use a long random key in production.
# Keep this server-side only.
INTEGRATION_ENCRYPTION_KEY=

# Optional CurseForge marketplace search/install. Modrinth works without an API key.
# CurseForge requires an x-api-key from the CurseForge developer console.
CURSEFORGE_API_KEY=

# Web panel
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Public BlockCtrl panel origin used by deployed websites for live data, login/register and forms.
# In production set this to the public panel URL, e.g. https://your-panel.vercel.app
BLOCKCTRL_PUBLIC_URL=

# PostgreSQL / Neon (one connection URL is enough)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
# POSTGRES_URL=
# NEON_DATABASE_URL=
# For Vercel/serverless production, prefer Neon's pooled connection string (hostname usually contains -pooler).
# Per-function node-postgres pool controls. Keep the total across autoscaled instances within DB limits.
PG_POOL_MAX=10
PG_POOL_IDLE_TIMEOUT_MS=10000
PG_POOL_CONNECTION_TIMEOUT_MS=10000
PG_POOL_MAX_LIFETIME_SECONDS=300

# Supabase Auth
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
# Legacy/alternative names supported by the current code:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_URL=
# SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_ANON_KEY=

# BlockCtrl website publishing (server-side only)
# Create a Vercel access token with project/deployment permissions.
VERCEL_TOKEN=
# On Vercel, VERCEL_ORG_ID can be used automatically; set TEAM_ID explicitly outside Vercel.
VERCEL_TEAM_ID=
# Optional alternative to VERCEL_TEAM_ID:
# VERCEL_TEAM_SLUG=
# Free website project names become: <website-name>-blockctrl.vercel.app
BLOCKCTRL_WEBSITE_PROJECT_SUFFIX=blockctrl
# Website builder image/video uploads (Vercel Blob)
# Vercel Blob store connection normally provides this automatically in production.
BLOB_READ_WRITE_TOKEN=

# Website server-registration bridge (server/plugin -> BlockCtrl website account provisioning)
# Use a long random secret; never expose it to browser code.
BLOCKCTRL_SITE_SERVER_BRIDGE_KEY=

# Integrations
# Optional Discord bot worker. Webhooks work without this; bot-specific commands/events require a deployed worker.
DISCORD_BOT_WORKER_URL=
# Optional direct WebRTC/live-stream gateway. External YouTube/Twitch/Kick links work without it.
LIVE_STREAM_GATEWAY_URL=

# Streaming OAuth applications. Configure provider callback URLs as:
#   <NEXT_PUBLIC_APP_URL>/api/integrations/oauth/callback?platform=<youtube|twitch|kick>
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=

# Integration secrets are encrypted at rest by lib/integrations. Use a long random key in production.
# Keep this server-side only.
INTEGRATION_ENCRYPTION_KEY=

# Oracle Cloud Infrastructure NSG (server-side only)
# Read-only diagnostics require all credentials below plus an NSG OCID.
OCI_REGION=
OCI_TENANCY_OCID=
OCI_USER_OCID=
OCI_FINGERPRINT=
# Prefer base64 to preserve PEM newlines in hosted environment variables.
OCI_PRIVATE_KEY_B64=
# Optional plain PEM alternative (use escaped \n in single-line env values).
# OCI_PRIVATE_KEY=
# One NSG for all nodes or a JSON nodeId -> NSG OCID map.
OCI_NSG_OCID=
OCI_NODE_NSGS={}
# Safe default: no cloud firewall mutation. Enable explicitly only after read diagnostics work.
OCI_NSG_WRITE_ENABLED=false


# Agent security automation (set these in agent/.env or service environment)
# Repeated failed Minecraft authentication attempts from one IP trigger a temporary UFW block.
BLOCKCTRL_BRUTE_FORCE_WINDOW_MS=600000
BLOCKCTRL_BRUTE_FORCE_THRESHOLD=8
BLOCKCTRL_BRUTE_FORCE_BLOCK_MS=900000
# Connection burst protection for simple bot/flood patterns.
BLOCKCTRL_BOT_WINDOW_MS=60000
BLOCKCTRL_BOT_THRESHOLD=40
BLOCKCTRL_BOT_BLOCK_MS=300000
# Optional HTTP reputation service. Use {ip} in the URL or the agent appends ?ip=<address>.
# Expected JSON may expose vpn/proxy/tor/hosting/risky booleans and/or risk/riskScore/score.
BLOCKCTRL_IP_REPUTATION_URL=
BLOCKCTRL_IP_REPUTATION_TOKEN=

# Observability / operational alerts
# Optional JSON webhook for degraded health/runtime alerts.
BLOCKCTRL_ALERT_WEBHOOK_URL=
# Optional comma-separated recipients. Requires Resend configuration below.
BLOCKCTRL_ALERT_EMAIL_TO=
# Transactional email provider (server-side only)
RESEND_API_KEY=
EMAIL_FROM=BlockCtrl <alerts@your-domain.example>
